      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 0.0,
      "end": 6.5,
      "text": "Kartal Konutları B Blok, günlük rapor. Bugün hava açıktı, yağmur yok."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 6.5,
      "end": 14.0,
      "text": "Usta Beton dört kişiyle bütün gün çalıştı, üçüncü kat döşemesinin dökümünü saat ikide bitirdik, yaklaşık kırk beş metreküp."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 14.0,
      "end": 20.5,
      "text": "Volt Elektrik üç kişi, ikinci katta tesisat çekti, tam gün."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 20.5,
      "end": 27.0,
      "text": "Akış Mekanik iki kişi öğleden sonra geldi, saat birden beşe kadar havalandırma kanalı taktılar."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 27.0,
      "end": 33.5,
      "text": "Bizim öz ekip beş kişi, birinci katta kalıp söktük, demirci ekibi de dördüncü katın donatısına başladı."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 33.5,
      "end": 40.0,
      "text": "Sabah TBM yaptık, iskele güvenliğini konuştuk. Kaza yok, yaralanan yok."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a1",
      "start": 40.0,
      "end": 45.5,
      "text": "Yarın sabah yedide beton pompası lazım. Üç fotoğraf gönderiyorum."
    }
  ]
