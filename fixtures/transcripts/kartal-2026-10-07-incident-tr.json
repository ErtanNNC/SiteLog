      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 0.0,
      "end": 5.0,
      "text": "Kartal B Blok, yedi ekim çarşamba. Hava açık, yağmur yok."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 5.0,
      "end": 11.5,
      "text": "Usta Beton üç kişi tam gün, altıncı katta kolon kalıpları."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 11.5,
      "end": 17.5,
      "text": "Öz ekip dört kişi tam gün, üçüncü katta sıva."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 17.5,
      "end": 27.0,
      "text": "Öğleden sonra bir kaza oldu: öz ekipten bir işçi spiral taşlamayla elini kesti. İlk yardım dolabından pansuman yaptık, hastaneye gerek olmadı, işine döndü."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 27.0,
      "end": 35.0,
      "text": "Bir de ramak kala var: dördüncü kattan bir kalıp tahtası aşağı düştü, altında kimse yoktu, alanı şeritle kapattık."
    },
    {
      "uploadId": "d1000000-0000-4000-8000-0000000000a7",
      "start": 35.0,
      "end": 41.0,
      "text": "Sabah TBM'de iskele güvenliğini konuşmuştuk. İki fotoğraf gönderiyorum."
    }
  ]
