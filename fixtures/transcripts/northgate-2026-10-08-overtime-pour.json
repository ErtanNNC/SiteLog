    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 0,
      "end": 6.4,
      "text": "Northgate, Thursday. Big day, we poured ramp B."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 6.4,
      "end": 14.8,
      "text": "A hundred and twelve yards, the pump showed up at six forty-five and the last truck was around four."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 14.8,
      "end": 23,
      "text": "Apex had four guys, full day plus two hours overtime finishing, so ten hours each."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 23,
      "end": 30.5,
      "text": "Ironclad, three guys till three, then they left. Our crew, five guys, stayed till six to cure and cover."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 30.5,
      "end": 37,
      "text": "Ready-mix was fourteen trucks, no rejected loads."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 37,
      "end": 43,
      "text": "Dry, about seventy degrees, perfect pour weather. No incidents, toolbox talk on pump hose safety."
    },
    {
      "messageId": "e0000011-0000-4000-8000-000000001101",
      "start": 43,
      "end": 50,
      "text": "Tomorrow we strip the edge forms on the ramp, and the inspector's coming at ten for the level two PT deck."
    }
  ],
