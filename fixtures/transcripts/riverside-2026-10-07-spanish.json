  "segments": [
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 0,
      "end": 6.8,
      "text": "Buenas, reporte del miércoles, Riverside bloque B. Día seco, sin lluvia, todo normal."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 6.8,
      "end": 14.9,
      "text": "Hoy hicimos el colado de los muros del cubo del elevador, como veinticuatro yardas, terminamos como a la una."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 14.9,
      "end": 21.6,
      "text": "Apex con seis trabajadores todo el día en el colado."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 21.6,
      "end": 29,
      "text": "BrightLine, cuatro electricistas en el nivel tres hasta las dos, siguen con la tubería, van como a la mitad."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 29,
      "end": 35.2,
      "text": "Los de Delta, cinco, todo el día con los ductos en el nivel dos, ala oeste."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 35.2,
      "end": 41.7,
      "text": "Ironclad, dos muchachos, medio día, amarrando varilla para la losa del cuatro."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 41.7,
      "end": 48,
      "text": "Nuestros cuatro peones todo el día, limpieza y ayudando con el colado."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 48,
      "end": 55.5,
      "text": "A las nueve llegó el andamio para la fachada norte, lo armamos mañana."
    },
    {
      "uploadId": "e0000004-0000-4000-8000-000000000401",
      "start": 55.5,
      "end": 62,
      "text": "Plática de seguridad sobre andamios y arnés. Sin incidentes, nadie se lastimó. Mando una foto."
    }
  ]
