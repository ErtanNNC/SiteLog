  "segments": [
    {
      "messageId": "33333333-0000-4000-8000-000000000301",
      "start": 0.0,
      "end": 7.0,
      "text": "Hillcrest, Friday. We got rained out. Started at seven, it was drizzling, then it came down hard around ten."
    },
    {
      "messageId": "33333333-0000-4000-8000-000000000301",
      "start": 7.0,
      "end": 14.5,
      "text": "By eleven the footings were flooded so I sent everybody home at eleven. We lost the rest of the day, call it five hours."
    },
    {
      "messageId": "33333333-0000-4000-8000-000000000301",
      "start": 14.5,
      "end": 21.0,
      "text": "Before that Apex had five guys setting forms on the north footings, they got maybe half of them set, and Ironclad two guys on rebar cages."
    },
    {
      "messageId": "33333333-0000-4000-8000-000000000301",
      "start": 21.0,
      "end": 26.0,
      "text": "Our two laborers were pumping water most of the morning."
    },
    {
      "messageId": "33333333-0000-4000-8000-000000000301",
      "start": 26.0,
      "end": 31.0,
      "text": "No incidents. Sending a photo of the footings so you can see the water. Nobody worked after eleven."
    }
  ],
