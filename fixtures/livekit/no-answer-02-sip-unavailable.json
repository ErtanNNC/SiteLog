{
  "event": "participant_left",
  "room": {
    "sid": "RM_{{room_sid}}",
    "name": "{{room}}",
    "emptyTimeout": 300,
    "departureTimeout": 20,
    "creationTime": "{{ts}}",
    "enabledCodecs": [
      {
        "mime": "audio/opus"
      }
    ],
    "metadata": "",
    "numParticipants": 1
  },
  "participant": {
    "sid": "PA_sip{{room_sid}}",
    "identity": "sip_{{phone}}",
    "state": "DISCONNECTED",
    "joinedAt": "{{ts+2}}",
    "name": "Phone {{phone}}",
    "version": 2,
    "permission": {
      "canSubscribe": true,
      "canPublish": true,
      "canPublishData": true
    },
    "kind": "SIP",
    "attributes": {
      "sip.callID": "SCL_{{room_sid}}",
      "sip.callStatus": "hangup",
      "sip.phoneNumber": "{{phone}}",
      "sip.trunkID": "ST_sitelogUS",
      "sip.trunkPhoneNumber": "{{to}}"
    },
    "disconnectReason": "USER_UNAVAILABLE"
  },
  "id": "{{id}}",
  "createdAt": "{{ts+32}}"
}
