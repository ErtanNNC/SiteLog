{
  "name": "@sitelog/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the SQL migrations + seed against PGlite and tests RLS policies and RPCs; `test:stack` runs the real-Postgres tests against a running local Supabase stack.",
  "scripts": {
    "test": "vitest run",
    "test:stack": "vitest run --config vitest.stack.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sitelog/shared": "workspace:*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
