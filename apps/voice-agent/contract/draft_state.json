      "minimum": 1,
      "maximum": 9007199254740991
    },
    "missing": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "question": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "choices": {
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "required": [
            "id",
            "text",
            "choices"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "readBack": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reportId",
    "draftRev",
    "missing",
    "question",
    "readBack"
  ],
  "additionalProperties": false
}
