        "filed",
        "draft_saved",
        "no_work",
        "weather_day",
        "edit_applied",
        "callback_requested",
        "fallback_recording",
        "abandoned",
        "not_reached"
      ]
    },
    "dialogLog": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "speaker": {
            "type": "string",
            "enum": [
              "agent",
              "reporter"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "t",
          "speaker",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "latencyP50Ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "latencyP95Ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "interruptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sttConfidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
