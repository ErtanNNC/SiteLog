{
  "name": "@sitelog/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteLog job runner: WhatsApp media, transcription, Claude extraction, PDFs, email, weather.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/ai/eval.ts",
    "render-sample-pdf": "tsx src/pdf/render-sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/node": "^11.6.0",
    "@sitelog/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.7",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^7.32.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
