{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    // src/integration imports supabase/functions/whatsapp-webhook/logic.ts, whose bare
