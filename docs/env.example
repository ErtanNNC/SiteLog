# SiteLog — environment template (spec §5.1). Copy to .env (server side).
# Browser apps read only VITE_* from apps/web/.env.local and apps/field/.env.local.
# [W1] = needed in week 1 (M0–M5) · [W2+] = later · (local) = value for `supabase start`

# ── Supabase ─────────────────────────────────────────────────────────────── [W1]
SUPABASE_URL=http://127.0.0.1:54321             # (local) — hosted: https://<ref>.supabase.co
SUPABASE_ANON_KEY=                               # from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=                       # functions, worker, scripts only — never in VITE_*
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # (local) worker job queue

# Browser-safe (copy into apps/*/.env.local)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=                          # panel only
VITE_FIELD_API_URL=/api                          # field app: same-origin, proxied to field-api (Vite proxy / host rewrite)
VITE_FEATURE_TALK_NOW=false                      # field app: show Talk now (week 2, needs LiveKit)

# ── Apps ─────────────────────────────────────────────────────────────────── [W1]
APP_URL=http://localhost:5173                    # office panel
FIELD_APP_URL=http://localhost:5174              # field web recorder (use a LAN IP or tunnel to test on a phone)
FIELD_API_URL=http://127.0.0.1:54321/functions/v1/field-api
LINK_SHORT_DOMAIN=http://localhost:5174          # prod: https://sl.link
LINK_SIGNING_SECRET=change-me-32-bytes-min       # openssl rand -hex 32
DAILY_LINK_TTL_HOURS=72

# ── SMS ──────────────────────────────────────────────────────────────────── [W1: console]
SMS_US_PROVIDER=console                          # twilio once the toll-free number is verified
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_US_FROM=
SMS_TR_PROVIDER=console                          # iletimerkezi once the SITELOG title is approved
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
SMS_TR_SENDER_TITLE=SITELOG

# ── AI ───────────────────────────────────────────────────────────────────── [W1]
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                                    # Sonnet-class model id for extraction/writing (see docs.claude.com models page)
CLAUDE_MODEL_FAST=                               # Haiku-class model id for intents and live call turns
DEEPGRAM_API_KEY=                                # $200 sign-up credit; batch STT now, live STT + Aura-2 TTS in W2
TRANSCRIBE_PROVIDER=deepgram                     # deepgram | openai
TRANSCRIBE_MODEL=nova-3
OPENAI_API_KEY=                                  # only if TRANSCRIBE_PROVIDER=openai

# ── Weather ──────────────────────────────────────────────────────────────── [W1]
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast   # free, non-commercial — dev/demo only
WEATHER_API_KEY=                                 # prod: customer-api.open-meteo.com + key

# ── Email ────────────────────────────────────────────────────────────────── [W1]
EMAIL_PROVIDER=console                           # resend | console
RESEND_API_KEY=
EMAIL_FROM="SiteLog <onboarding@resend.dev>"     # Resend test sender until a domain is verified

# ── Voice: LiveKit + speech ──────────────────────────────────────────────── [W2+]
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=sitelog-voice
VOICE_NUMBER_US=
VOICE_NUMBER_TR=                                 # empty → TR calls via Talk now only
LIVEKIT_SIP_OUTBOUND_TRUNK_US=
LIVEKIT_SIP_OUTBOUND_TRUNK_TR=
VOICE_AGENT_TOOL_SECRET=
STT_MODEL=nova-3
TTS_VOICE_EN=aura-2-thalia-en
TTS_VOICE_ES=aura-2-nestor-es
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE_TR=tr-TR-EmelNeural

# ── Billing ──────────────────────────────────────────────────────────────── [W4]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SITE_US=
TR_BILLING_PROVIDER=

# ── Ops ──────────────────────────────────────────────────────────────────── [W1]
WORKER_CONCURRENCY=4
AUDIO_RETENTION_DAYS=730
SENTRY_DSN=                                      # optional in week 1
