# ───────────── Supabase ─────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=                 # web (as VITE_SUPABASE_ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=         # functions + worker only — never in the browser
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres   # worker job loop

# ───────────── Web (Vite) ─────────────
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
VITE_WA_DISPLAY_NUMBER=+15550142290
VITE_DEMO=false                    # true → in-memory Kestrel demo data, no Supabase needed
VITE_SENTRY_DSN=

# ───────────── WhatsApp Cloud API ─────────────
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                   # system user token
WA_APP_SECRET=                     # for X-Hub-Signature-256
WA_VERIFY_TOKEN=                   # webhook verification challenge
WA_DISPLAY_NUMBER=+15550142290
WA_GRAPH_VERSION=v21.0

# ───────────── AI ─────────────
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1         # must return segment timestamps (verbose_json)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5     # extraction + writing
CLAUDE_MODEL_FAST=claude-haiku-5-5 # intent classification of short replies

# ───────────── Weather ─────────────
WEATHER_API_BASE=https://customer-api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# ───────────── Email ─────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="SiteLog <reports@sitelog.app>"

# ───────────── Stripe ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SITE=              # $399/month per-unit price

# ───────────── App ─────────────
APP_URL=https://app.sitelog.app
WORKER_CONCURRENCY=4
WORKER_PORT=8080
AUDIO_RETENTION_DAYS=730
SENTRY_DSN=
SCHEDULER_SECRET=                  # shared secret pg_cron sends to scheduler-tick
LOG_LEVEL=info
