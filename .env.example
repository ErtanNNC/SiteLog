# TalkOlog — environment template (spec v1.2 §5.1, merged with the variables the current code reads).
# Copy to .env (server side). Browser apps read only VITE_* (apps/web/.env.local, apps/field/.env.local).
# The worker and `pnpm eval` (outside production) read this root .env, plus an optional
# apps/worker/.env whose values win. Local edge functions read supabase/functions/.env.
# [W1] = needed in week 1 (M0–M5) · [W2+] = later · (local) = value for `supabase start`
# (v1.0) = read by the v1.0 Meta WhatsApp Cloud API code; removed at GAP step 22 (WhatsApp itself returns through Twilio in week 2, D49)
# Keys go here, in Supabase secrets or in GitHub Environment secrets — never in the chat or in VITE_*.

# ── Supabase ─────────────────────────────────────────────────────────────── [W1]
SUPABASE_URL=http://127.0.0.1:54321             # (local) — hosted: https://<ref>.supabase.co
SUPABASE_ANON_KEY=                               # from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=                       # functions, worker, scripts only — never in VITE_*
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # (local) worker job queue
SUPABASE_DB_LISTEN_URL=                          # worker, W1-10: the session-mode connection it LISTENs on for new jobs; empty =
                                                 # SUPABASE_DB_URL. Set it when SUPABASE_DB_URL is the transaction pooler (port 6543),
                                                 # which delivers no NOTIFY: the direct connection or the session pooler (port 5432)
STORAGE_PUBLIC_URL=                              # supabase/functions/.env, local stacks only: the API URL as the browser reaches it
                                                 # (http://127.0.0.1:54321, or a tunnel to it for a phone); field-api re-bases its signed
                                                 # upload URLs on it (the functions see http://kong:8000). Unset on hosted projects.

# Browser-safe (copy into apps/*/.env.local)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=                          # panel only
VITE_APP_URL=http://localhost:5173               # panel: its own public URL (magic-link redirect)
VITE_DEMO=false                                  # panel: true → in-memory Kestrel demo data, no Supabase needed
VITE_SENTRY_DSN=                                 # optional
VITE_FIELD_API_URL=/api                          # field app: same-origin, proxied to field-api (Vite proxy / host rewrite)
VITE_DEMO_PHONE_ALL_ORGS=false                   # panel, staging only: true → admins of every org get the Demo phone (real orgs' codes masked)
VITE_WA_DISPLAY_NUMBER=+15550142290              # (v1.0) staging panel sidebar number; the v1.2 panel no longer reads it

# ── Apps ─────────────────────────────────────────────────────────────────── [W1]
APP_URL=http://localhost:5173                    # office panel; also the CORS origin of the api-* functions. prod: https://app.talkolog.com (spec §19 Q360)
CORS_EXTRA_ORIGINS=                              # functions: more browser origins, comma-separated exact URLs (a panel or field preview; field-api accepts them as Origin)
# Field web recorder: the field app's Vite servers read it for their allowed host. To test on a phone
# use an HTTPS tunnel (a plain-http LAN address drops the Secure device cookie, so the device check
# never sticks). field-api reads its allowed Origin from supabase/functions/.env (FIELD_APP_URL /
# CORS_EXTRA_ORIGINS), not from this file: set the tunnel URL there too.
FIELD_APP_URL=http://localhost:5174              # also the host of the links in texts (worker, api-invite-reporter, sms-webhook). prod: https://go.talkolog.com
FIELD_API_URL=http://127.0.0.1:54321/functions/v1/field-api   # server-side callers; export it in the shell for the field-api suite of `pnpm test:stack`
LINK_SHORT_DOMAIN=http://localhost:5174          # prod: https://go.talkolog.com, the field app's own host (spec §19 Q360)
LINK_SIGNING_SECRET=change-me-32-bytes-min       # openssl rand -hex 32; HMAC key of the device codes and of the personal link codes; the worker and
                                                 # supabase/functions/.env must hold the same value (spec §4.5, §19 Q47)
DAILY_LINK_TTL_HOURS=72
SCHEDULER_SECRET=                                # shared secret pg_cron sends to scheduler-tick

# ── Messaging providers (credentials only) ──────────────────────────────── [W1: console]
# Which provider, sender, two-way SMS and links each country uses is its country pack (`countries`,
# spec §4.6). A pack with no SMS sender id in this database sends SMS through `console`; set one
# with `pnpm countries:set` once the sender is approved (owner-approved on hosted databases).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                               # default provider for SMS and WhatsApp (W2-15); also validates X-Twilio-Signature
ILETIMERKEZI_API_KEY=                            # only for packs whose sms_provider = iletimerkezi (TR)
ILETIMERKEZI_API_HASH=
ILETIMERKEZI_IYS=                                # TR texts' İYS type (spec §19 Q49): empty = informational (no İYS fields); commercial only
                                                 # after counsel and İletimerkezi confirm the fields (§19 Q281). Worker and edge functions.
ILETIMERKEZI_STATUS=poll                         # worker (W4-11, §19 Q237): poll = read İletimerkezi delivery reports +2 min/+15 min/+2 h
                                                 # (sms_status job); off = rows stay `sent`. Reads nothing until the report endpoint is confirmed (§19 Q280)
SMS_WEBHOOK_URL=                                 # sms-webhook's public URL, which Twilio signs (default {SUPABASE_URL}/functions/v1/sms-webhook);
                                                 # locally http://127.0.0.1:54321/functions/v1/sms-webhook. Delivery callbacks ({…}/status) only when https
# The worker reads these too (it sends the welcome); keyless, every text goes to `console` and the Demo phone.
WELCOME_RESEND=auto                              # worker (W4-12, §19 Q241, F3): auto = one automatic welcome re-send 48 h after it reached
                                                 # the phone with no reaction, in the site's daytime (09:00-18:00); off = the office's Re-send only
# The WhatsApp sender and its template ids have no env var either: they are the pack's per-environment
# whatsapp_sender_id and whatsapp_templates (spec §19 Q39, W2-15), set with
# `pnpm countries:set -- --code XX --whatsapp-sender … --whatsapp-templates <file>`.

# ── WhatsApp Cloud API (Meta) ── (v1.0; retired at GAP step 22, not the week-2 Twilio WhatsApp)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                                 # system user token
WA_APP_SECRET=                                   # for X-Hub-Signature-256
WA_VERIFY_TOKEN=                                 # webhook verification challenge
WA_DISPLAY_NUMBER=+15550142290
WA_GRAPH_VERSION=v21.0

# ── AI ───────────────────────────────────────────────────────────────────── [W1]
ANTHROPIC_API_KEY=
EXTRACT_PROVIDER=claude                          # claude | fake (fixtures/tool-outputs), fake only when set here; no key → extraction fails; fake refused in production
CLAUDE_MODEL=claude-sonnet-5-5                   # Sonnet-class model id for extraction/writing; do not leave empty
CLAUDE_MODEL_FAST=claude-haiku-5-5               # Haiku-class model id for intents and live call turns
DEEPGRAM_API_KEY=                                # $200 sign-up credit; batch STT (W1-11), live STT + Aura-2 TTS in W2
TRANSCRIBE_PROVIDER=deepgram                     # deepgram | openai | fake, fake only when set here; no key → transcription fails; fake refused in production
TRANSCRIBE_MODEL=nova-3                          # the provider's model (empty: nova-3 / whisper-1)
OPENAI_API_KEY=                                  # TRANSCRIBE_PROVIDER=openai, and the v1.0 WhatsApp voice notes (whisper-1) until step 22

# ── Weather ──────────────────────────────────────────────────────────────── [W1]
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast   # free, non-commercial — dev/demo only
WEATHER_API_KEY=                                 # prod: customer-api.open-meteo.com + key

# ── Email ────────────────────────────────────────────────────────────────── [W1]
EMAIL_PROVIDER=console                           # resend | console
RESEND_API_KEY=
EMAIL_FROM="TalkOlog <onboarding@resend.dev>"     # Resend test sender until a domain is verified; prod: "TalkOlog <reports@talkolog.com>"

# ── Voice: LiveKit + speech ──────────────────────────────────────────────── [W2+]
LIVEKIT_URL=                                     # W3-13: with the key pair, field-api offers Talk now (talkNow) and mints its tokens
LIVEKIT_API_KEY=                                 # also the issuer voice-events expects on LiveKit's webhook JWT (W3-04)
LIVEKIT_API_SECRET=                              # also verifies LiveKit's webhooks in voice-events (W3-04); pnpm replay-webhook signs fixtures/livekit with this pair (local only)
LIVEKIT_AGENT_NAME=sitelog-voice                 # the agent field-api dispatches to a Talk now room (W3-13) and the worker to an outbound call's room (W3-17)
# Voice numbers and outbound trunks are the country packs' (countries.voice_number and
# countries.outbound_trunk_id, set with `pnpm countries:set -- --voice … --outbound-trunk ST_…`;
# spec §19 Q125, Q126), not env. A pack without a trunk places no calls for real orgs; a demo org's
# calls ring the panel's Demo phone (console telephony, §19 Q132). The worker places the calls, so
# it needs the LIVEKIT_* values above too.
VOICE_MAX_CONCURRENT_CALLS=4                     # [W3, M8] the worker: outbound calls at once on LiveKit (§19 Q127; Build plan: 5 sessions, one kept for inbound and Talk now)
VOICE_RING_TIMEOUT_S=30                          # [W3, M8] the worker: how long an outbound call rings before no answer (then missed_call)
CONSOLE_CALL_RING_S=30                           # [W3, M8] the worker: how long a demo org's call rings in the Demo phone before no answer
VOICE_AGENT_TOOL_SECRET=                         # [W3] openssl rand -base64 32; the agent's bearer on field-api's /voice/* routes (the agent and field-api)
VOICE_CALL_TOKEN_SECRET=                         # [W3] openssl rand -base64 32; field-api only: signs the per-call tokens (W3-03), never given to the agent
VOICE_TOOL_WAIT_MS=                              # [W3] optional (field-api): how long update_draft / record_answer wait for their worker turn (§19 Q117); default 12000, at most 15000
STT_MODEL=nova-3
TTS_VOICE_EN=aura-2-thalia-en
TTS_VOICE_ES=aura-2-nestor-es
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE_TR=tr-TR-EmelNeural

# ── Web push (M6, W2-14) ──────────────────────────────────────────────────── [W2+]
# A pair for local work: `npx web-push generate-vapid-keys`. Hosted values: the owner sets them
# (worker env; VAPID_PUBLIC_KEY also as a functions secret). Without all three: push is console for
# demo orgs (the Demo phone) and off for real orgs, whose messages go by SMS.
VAPID_PUBLIC_KEY=                                # worker + field-api (GET /field/push/key; no VITE_* key)
VAPID_PRIVATE_KEY=                               # worker only: never a functions secret or a VITE_* value
VAPID_SUBJECT=                                   # worker: mailto: or https: contact

# ── Billing ──────────────────────────────────────────────────────────────── [W4]
# W4-10: the price is the org's (orgs.price_per_site_minor, preset by create_org from the
# billing_default_prices table: USD 39900; TalkOlog staff change it on /ops). A Stripe org's
# Checkout bills the Stripe price of its currency, STRIPE_PRICE_ID_SITE_<CURRENCY>, whose amount
# must equal the org's price (else 409 price_mismatch). A TR org is billed `manual` (§19 Q236).
STRIPE_SECRET_KEY=                               # functions (api-billing, stripe-webhook) + worker (billing_sync); without it the worker's billing_sync only logs
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SITE_US=                         # the USD per-unit price ($399/month); api-billing still reads the old STRIPE_PRICE_ID_SITE when this is unset (GAP 9.1)
TR_BILLING_PROVIDER=                             # not read yet: TR orgs are `manual` until §19 Q8 (W4-15)

# ── Ops ──────────────────────────────────────────────────────────────────── [W1]
WORKER_CONCURRENCY=4
WORKER_PORT=8080                                 # worker /health
POLL_INTERVAL_MS=5000                            # worker, W1-10: the poll fallback; NOTIFY jobs wakes it at once for a new job
AUDIO_RETENTION_DAYS=730
SENTRY_DSN=                                      # optional in week 1
LOG_LEVEL=info
# Test only, never on a hosted project (and refused in production): WORKER_CLOCK_OVERRIDE=true with
# WORKER_CLOCK_START=<ISO instant> runs the worker on a test clock from that instant (CI's
# e2e-supabase, beside scheduler-tick's SCHEDULER_CLOCK_OVERRIDE `?now=`). Not set here on purpose.
# Likewise SMS_PROVIDER_STUB=true with TWILIO_API_BASE and ILETIMERKEZI_API_BASE (W4-12): the worker's and the edge
# functions' SMS drivers send to the local SMS stand-in (`pnpm sms:stand-in`, :4010) instead of the providers.
COST_WA_TEMPLATE_USD=0.004                       # (v1.0) worker: Meta price per template message (cost-per-report estimate); goes at step 22 (D45, D49)
COST_SMS_USD=0.0083                              # worker, W2-15: per text a provider took, in a report's cost (D49 (5))
COST_WHATSAPP_TEMPLATE_USD=0.009                 # worker, W2-15: per business-initiated WhatsApp template (Meta + Twilio); session messages are free
