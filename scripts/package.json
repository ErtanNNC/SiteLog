    "whatsapp-templates": "tsx src/whatsapp-templates.ts",
    "cutover-preflight": "tsx src/cutover-preflight.ts",
    "db-types-drift": "tsx src/db-types-drift.ts",
    "voice-contract": "tsx src/voice-contract.ts",
    "demo-call-audio": "tsx src/demo-call-audio.ts",
    "simulate-call": "tsx src/simulate-call.ts",
    "voice-latency": "tsx src/voice-latency.ts",
    "voice-samples": "tsx src/voice-samples.ts",
    "sms-stand-in": "tsx src/sms-stand-in.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
