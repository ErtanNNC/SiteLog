{
  "name": "sitelog",
  "private": true,
  "version": "0.1.0",
  "description": "SiteLog \u2014 WhatsApp voice notes turned into official daily site reports.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sitelog/web dev",
    "dev:worker": "pnpm --filter @sitelog/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @sitelog/db test",
    "e2e": "pnpm --filter @sitelog/web e2e",
    "e2e:supabase": "pnpm --filter @sitelog/web e2e:supabase",
    "eval": "pnpm --filter @sitelog/worker eval",
    "loadtest": "pnpm --filter @sitelog/worker loadtest",
    "replay-webhook": "pnpm --filter @sitelog/scripts replay-webhook",
    "seed:demo": "pnpm --filter @sitelog/scripts seed-demo",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "@electric-sql/pglite"
    ]
  }
}
