{
  "name": "sitelog",
  "private": true,
  "version": "0.1.0",
  "description": "SiteLog: a site manager's 3-minute voice report, from a text link or a phone call, turned into an official daily site report, subcontractor hours and a weather-delay record.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sitelog/web --filter @sitelog/field dev",
    "dev:web": "pnpm --filter @sitelog/web dev",
    "dev:field": "pnpm --filter @sitelog/field dev",
    "dev:worker": "pnpm --filter @sitelog/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @sitelog/db test",
    "test:stack": "pnpm --filter @sitelog/db test:stack && pnpm --filter @sitelog/worker test:stack",
    "e2e": "pnpm --filter @sitelog/web e2e && pnpm --filter @sitelog/field e2e",
    "e2e:supabase": "pnpm --filter @sitelog/web e2e:supabase && pnpm --filter @sitelog/field e2e:supabase",
    "e2e:m6": "pnpm --filter @sitelog/web e2e:supabase --grep @m6 && pnpm --filter @sitelog/field e2e:supabase --grep @m6",
    "eval": "pnpm --filter @sitelog/worker eval",
    "transcribe:fixture": "pnpm --filter @sitelog/worker transcribe:fixture",
    "loadtest": "pnpm --filter @sitelog/worker loadtest",
    "replay-webhook": "pnpm --filter @sitelog/scripts replay-webhook",
    "seed:demo": "pnpm --filter @sitelog/scripts seed-demo",
    "countries:set": "pnpm --filter @sitelog/scripts countries-set",
    "cutover:preflight": "pnpm --filter @sitelog/scripts cutover-preflight",
    "voice:contract": "pnpm --filter @sitelog/scripts voice-contract",
    "brand": "pnpm --filter @sitelog/web brand && pnpm --filter @sitelog/field brand",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "@electric-sql/pglite"
    ]
  }
}
